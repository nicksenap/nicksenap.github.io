---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="site-title">{SITE_TITLE}</a>
		<div class="nav-right">
			<div class="nav-links">
				<HeaderLink href="/">About</HeaderLink>
				<span class="sep">/</span>
				<HeaderLink href="/thoughts">Thoughts</HeaderLink>
				<span class="sep">/</span>
				<HeaderLink href="/works">Works</HeaderLink>
			</div>
			<button class="action-btn" id="theme-toggle" tabindex="0" role="button">
				<span class="hotkey">&#x2303;+T</span>
				<span class="label" id="theme-label">Light</span>
			</button>
		</div>
	</nav>
</header>

<script>
	function initTheme() {
		const toggle = document.getElementById('theme-toggle');
		const label = document.getElementById('theme-label');
		const root = document.documentElement;

		const saved = localStorage.getItem('theme');
		if (saved === 'light') {
			root.classList.add('theme-light');
			if (label) label.textContent = 'Dark';
		}

		toggle?.addEventListener('click', () => {
			root.classList.toggle('theme-light');
			const isLight = root.classList.contains('theme-light');
			localStorage.setItem('theme', isLight ? 'light' : 'dark');
			if (label) label.textContent = isLight ? 'Dark' : 'Light';
		});
	}
	initTheme();
	document.addEventListener('astro:after-swap', initTheme);
</script>

<style>
	header {
		box-shadow: var(--fg) 0 -2px 0 0 inset;
		padding: 0 var(--grid-padding);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 3rem;
	}
	.site-title {
		font-weight: 400;
		text-decoration: none;
		color: var(--fg);
		text-transform: uppercase;
	}
	.site-title:hover {
		text-decoration: none;
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.5ch;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.5ch;
	}
	.sep {
		color: var(--border);
		user-select: none;
	}
	.action-btn {
		display: flex;
		align-items: center;
		gap: 0;
		background: none;
		border: none;
		color: var(--fg);
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 1rem;
		line-height: 1;
		padding: 0;
	}
	.hotkey {
		padding: 4px 6px;
		background: var(--action-hotkey-bg);
	}
	.label {
		padding: 4px 8px;
		background: var(--action-content-bg);
		text-transform: uppercase;
	}
	.action-btn:hover .label {
		background: var(--accent);
		color: var(--bg);
	}
	@media (max-width: 520px) {
		nav {
			flex-wrap: wrap;
			height: auto;
			padding: 0.6rem 0;
			gap: 0.4rem;
		}
		.site-title {
			width: 100%;
		}
		.hotkey {
			display: none;
		}
	}
</style>
