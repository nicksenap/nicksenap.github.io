---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, tags } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<div class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span>
								&middot; updated <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					<h1>{title}</h1>
					{description && <p class="description">{description}</p>}
				{tags && tags.length > 0 && (
					<div class="tags">
						{tags.map((tag: string) => (
							<a href={`/thoughts/tags/${tag}/`} class="tag">{tag}</a>
						))}
					</div>
				)}
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
			<nav class="post-nav">
				<a href="/thoughts">&larr; Back to thoughts</a>
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		box-shadow: var(--border) 0 -1px 0 0 inset;
	}
	.meta {
		opacity: 0.5;
		margin-bottom: 0.75rem;
	}
	h1 {
		margin-bottom: 0.5rem;
	}
	.description {
		opacity: 0.5;
		margin: 0;
	}
	.tags {
		display: flex;
		gap: 0.5ch;
		margin-top: 0.75rem;
	}
	.tag {
		opacity: 0.5;
		text-decoration: none;
		transition: opacity 0.15s;
	}
	.tag::before {
		content: '#';
	}
	.tag:hover {
		opacity: 1;
	}
	.prose :global(h2) {
		margin-top: 2.5rem;
		padding-top: 1rem;
		box-shadow: var(--border) 0 2px 0 0 inset;
	}
	.prose :global(h3) {
		margin-top: 2rem;
	}
	.prose :global(img) {
		box-shadow:
			var(--fg) 2px 0 0 0 inset,
			var(--fg) -2px 0 0 0 inset,
			var(--fg) 0 -2px 0 0 inset,
			var(--fg) 0 2px 0 0 inset;
		margin: 1.5rem 0;
	}
	.post-nav {
		margin-top: 3rem;
		padding-top: 1rem;
		box-shadow: var(--border) 0 2px 0 0 inset;
	}
	.post-nav a {
		color: var(--fg);
		text-decoration: none;
		opacity: 0.5;
		transition: opacity 0.15s;
	}
	.post-nav a:hover {
		opacity: 1;
	}
</style>
