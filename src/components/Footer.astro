---
const today = new Date();
---

<footer>
	<span>⏵⏵ bypass permissions on (shift+tab to cycle)</span>
	<div class="footer-links">
		<a href="/rss.xml">RSS</a>
		<a href="https://github.com/nicksenap" target="_blank">GITHUB</a>
		<a href="https://www.linkedin.com/in/nick-zixian-song" target="_blank">LINKEDIN</a>
	</div>
</footer>

<style>
	footer {
		box-shadow: var(--fg) 0 2px 0 0 inset;
		padding: var(--grid-padding);
		margin-top: 3rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.footer-links {
		display: flex;
		gap: 1.5ch;
	}
	.footer-links a {
		color: var(--fg);
		text-decoration: none;
		opacity: 0.5;
		transition: opacity 0.15s;
	}
	.footer-links a:hover {
		opacity: 1;
	}
	@media (max-width: 768px) {
		footer {
			font-size: 0.75rem;
		}
	}
</style>
