---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="prose">
				<p>
					Hello. I'm Nick, a software engineer interested in building
					things for the web. This is where I write about
					<a href="/thoughts">technology, programming, and ideas</a>.
				</p>
				<p>
					Currently empowering teams with surprisingly smart tools at
						Funnel and writing
					<a href="/works">dev tools as multipliers for coding agents</a>.
					Previously at Klarna.
				</p>
				</div>
		</main>
		<Footer />
	</body>
</html>
