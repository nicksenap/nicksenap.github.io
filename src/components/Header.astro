---
import Backdrop from './Backdrop.astro';
import HeaderLink from './HeaderLink.astro';
---

<Backdrop />

<header>
	<nav>
		<a href="/" class="site-title">out of context</a>
		<div class="nav-links">
			<HeaderLink href="/">About</HeaderLink>
			<span class="sep">/</span>
			<HeaderLink href="/thoughts">Thoughts</HeaderLink>
			<span class="sep">/</span>
			<HeaderLink href="/works">Works</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		box-shadow: var(--fg) 0 -2px 0 0 inset;
		padding: 0 var(--grid-padding);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 3rem;
		font-family: var(--font-display);
		font-size: 16.5px;
	}
	.site-title {
		font-size: inherit;
		text-transform: uppercase;
		line-height: 1;
		font-weight: 400;
		text-decoration: none;
		color: var(--fg);
	}
	.site-title:hover {
		text-decoration: none;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.5ch;
	}
	.sep {
		color: var(--border);
		user-select: none;
	}
	@media (max-width: 520px) {
		nav {
			flex-wrap: wrap;
			height: auto;
			padding: 0.6rem 0;
			gap: 0.4rem;
		}
		.site-title {
			width: 100%;
		}
	}
</style>
