---
// Mirrors pi's status line: model › thinking › cwd › branch. The model segment links to the harness page.
const status = [
	{ text: 'Fable 5.1', href: '/harness', title: 'the harness, taken apart' },
	{ text: 'think:high' },
	{ text: '~/blog' },
	{ text: 'master' },
];
---

<footer>
	<span class="status" aria-label="status line">
		<span class="glyph">⬡</span>
		{status.map((s, i) => (
			<span class="seg">
				{i > 0 && <span class="sep">〉</span>}
				{s.href ? <a href={s.href} title={s.title}>{s.text}</a> : s.text}
			</span>
		))}
	</span>
	<div class="footer-links">
		<button class="fx" id="fx-toggle" type="button" aria-pressed="true" title="toggle background effects">FX</button>
		<a href="/rss.xml">RSS</a>
		<a href="https://github.com/nicksenap" target="_blank">GITHUB</a>
		<a href="https://www.linkedin.com/in/nick-zixian-song" target="_blank">LINKEDIN</a>
	</div>
</footer>

<script>
	const btn = document.getElementById('fx-toggle');
	const root = document.documentElement;
	const sync = () => btn?.setAttribute('aria-pressed', String(!root.classList.contains('no-fx')));
	sync();
	btn?.addEventListener('click', () => {
		root.classList.toggle('no-fx');
		localStorage.setItem('fx', root.classList.contains('no-fx') ? 'off' : 'on');
		sync();
	});
</script>

<style>
	footer {
		box-shadow: var(--fg) 0 2px 0 0 inset;
		padding: var(--grid-padding);
		margin-top: 3rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2ch;
	}
	.status {
		display: flex;
		align-items: center;
		gap: 0.75ch;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.status .glyph {
		opacity: 0.5;
	}
	.status .seg {
		display: inline-flex;
		gap: 0.75ch;
	}
	.status .sep {
		opacity: 0.35;
	}
	.status a {
		text-decoration: none;
		text-decoration-color: var(--border);
	}
	.status a:hover {
		text-decoration: underline;
	}
	.footer-links {
		display: flex;
		gap: 1.5ch;
		flex-shrink: 0;
	}
	.footer-links a,
	.footer-links .fx {
		color: var(--fg);
		text-decoration: none;
		opacity: 0.5;
		transition: opacity 0.15s;
	}
	.footer-links .fx {
		all: unset;
		cursor: pointer;
		color: var(--fg);
		opacity: 0.5;
		transition: opacity 0.15s;
	}
	.footer-links a:hover,
	.footer-links .fx:hover {
		opacity: 1;
	}
	.footer-links .fx[aria-pressed='false'] {
		text-decoration: line-through;
	}
	@media (max-width: 768px) {
		footer {
			font-size: 0.75rem;
		}
		.status .seg:nth-child(n + 4) {
			display: none;
		}
	}
</style>
