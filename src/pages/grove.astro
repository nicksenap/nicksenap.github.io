---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import GroveScene from '../components/GroveScene.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const updated = new Date('2026-09-19');
const updatedLabel = updated.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const version = 'v1.1.18';

const commands = [
	{
		name: 'gw create',
		role: 'one branch, every repo',
		blurb: 'Names the branch, takes a repo list or a saved preset, and adds a worktree for each. A .grove.toml in the repo picks the base branch and runs setup once the checkout exists.',
	},
	{
		name: 'gw status',
		role: 'one table',
		blurb: 'Branch and working-tree state for the whole workspace in one table, so I stop visiting three directories to find out where I left off.',
	},
	{
		name: 'gw sync · reset · delete',
		role: 'the workspace as a unit',
		blurb: 'Rebase every repo onto its base branch, put every repo back on the workspace branch, or remove worktrees, branches and records together when the feature is merged.',
	},
	{
		name: 'gw plugin',
		role: 'gw-* on PATH',
		blurb: 'Anything not in core is a separate executable, git-style. Agent, terminal and recipe integrations live there so the core stays a plain worktree tool.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Grove — ${SITE_TITLE}`}
			description="Grove (gw): one feature branch across several repositories, created, inspected, synced and removed as one workspace."
		/>
	</head>
	<body>
		<Header />
		<main>
			<header class="intro">
				<div class="meta"><h1>Grove</h1><time datetime={updated.toISOString().slice(0, 10)}>{updatedLabel}</time></div>
				<p class="lede">
					A CLI I wrote for working across several repos at once. One command puts every repo on the same
					branch in one directory; the rest of the commands treat that directory as the unit. Code on
					<a href="https://github.com/nicksenap/grove" target="_blank" rel="noopener">GitHub</a>, docs in the
					<a href="https://github.com/nicksenap/grove#documentation" target="_blank" rel="noopener">README</a>.
				</p>
			</header>

			<GroveScene />

			<section aria-labelledby="why-title">
				<h2 id="why-title">Why</h2>
				<p>
					Monorepos get cross-project work for free. Most of what I touch is not a monorepo: separate repos,
					separate CI, separate deploys. A feature across a web app, an API and a worker meant
					<code>git worktree add</code> three times, three branch names to keep aligned, three places to check
					and three to clean up. Grove is that set of chores collapsed into one workspace, without moving
					anything into a monorepo.
				</p>
			</section>

			<section class="bom" aria-labelledby="commands-title">
				<h2 id="commands-title">Commands</h2>
				<ol class="parts">
					{commands.map((c, i) => (
						<li class="part">
							<span class="idx">{String(i + 1).padStart(2, '0')}</span>
							<div class="body">
								<div class="head">
									<span class="name">{c.name}</span>
									<span class="slot">{c.role}</span>
								</div>
								<p class="blurb">{c.blurb}</p>
							</div>
						</li>
					))}
				</ol>
			</section>

			<section aria-labelledby="install-title">
				<h2 id="install-title">Install</h2>
				<p>A single static binary; git is the only thing it needs on PATH.</p>
				<pre><code><span class="comment"># macOS / Linux</span>
brew install nicksenap/grove/grove

<span class="comment"># lets gw go / gw create change directory; add to .zshrc or .bashrc</span>
eval "$(gw shell-init)"

<span class="comment"># register the directory that holds your repos, then make a workspace</span>
gw init ~/dev
gw create -b feat/login -r web,api,worker
gw status feat-login</code></pre>
			</section>

			<p class="colophon">
				<em>grove</em>, noun: a small group of trees growing together. Drawn in code with <a href="https://zzz.dog" target="_blank" rel="noopener">Zdog</a>, one trunk per repo. Started in Python, <a href="/thoughts/rewriting-grove-in-go">rewritten in Go</a>
				for startup time and a one-file install. This page describes {version}; the date above is the last time it
				matched the tool.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 1.5rem;
	}
	.meta {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1ch;
	}
	.meta time {
		color: var(--dim);
		font-size: 0.85rem;
	}
	.lede {
		margin: 0;
		max-width: 60ch;
	}
	section {
		margin-top: 2rem;
	}
	section > p {
		max-width: 62ch;
	}
	.parts {
		list-style: none;
		margin: 0;
		padding: 0;
		box-shadow: var(--fg) 0 1px 0 0 inset;
	}
	.part {
		display: grid;
		grid-template-columns: 3ch 1fr;
		gap: 0 1ch;
		padding: 1rem 0;
		box-shadow: var(--border) 0 -1px 0 0 inset;
	}
	.idx {
		color: var(--dim);
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5ch;
		align-items: baseline;
		margin-bottom: 0.35rem;
	}
	.name {
		font-weight: 700;
	}
	.slot {
		color: var(--dim);
	}
	.blurb {
		margin: 0;
		opacity: 0.75;
		max-width: 62ch;
	}
	pre {
		margin: 0;
		font-size: 0.85rem;
	}
	.comment {
		color: var(--dim);
	}
	.colophon {
		margin: 2rem 0 0;
		font-size: 0.85rem;
		opacity: 0.5;
	}
</style>
