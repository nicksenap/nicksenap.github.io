---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="site-title">"{SITE_TITLE}"</a>
		<div class="nav-right">
			<div class="nav-links">
				<HeaderLink href="/">About</HeaderLink>
				<span class="sep">/</span>
				<HeaderLink href="/thoughts">Thoughts</HeaderLink>
				<span class="sep">/</span>
				<HeaderLink href="/works">Works</HeaderLink>
			</div>
			<button class="action-btn" id="theme-toggle" tabindex="0" role="button">
				<span class="hotkey">&#x2303;+T</span>
				<span class="label" id="theme-label">Light</span>
			</button>
		</div>
	</nav>
</header>

<script>
	function initTheme() {
		const toggle = document.getElementById('theme-toggle');
		const label = document.getElementById('theme-label');
		const root = document.documentElement;

		const saved = localStorage.getItem('theme');
		if (saved === 'light') {
			root.classList.add('theme-light');
			if (label) label.textContent = 'Dark';
		}

		function setGiscusTheme(theme: string) {
			const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
			iframe?.contentWindow?.postMessage(
				{ giscus: { setConfig: { theme } } },
				'https://giscus.app',
			);
		}

		function toggleTheme() {
			root.classList.toggle('theme-light');
			const isLight = root.classList.contains('theme-light');
			localStorage.setItem('theme', isLight ? 'light' : 'dark');
			if (label) label.textContent = isLight ? 'Dark' : 'Light';
			const base = window.location.origin;
			setGiscusTheme(isLight ? `${base}/giscus-terminal-light.css` : `${base}/giscus-terminal.css`);
		}

		toggle?.addEventListener('click', toggleTheme);

		document.addEventListener('keydown', (e) => {
			if (e.ctrlKey && e.key === 't') {
				e.preventDefault();
				toggleTheme();
			}
		});
	}
	initTheme();
	document.addEventListener('astro:after-swap', initTheme);

	function randomizeTitle() {
		const variants = [
			{ text: '"OUT OF CONTEXT"', font: "var(--font-mono)" },
			{ text: '「斷章取義」', font: "'Noto Serif TC', serif" },
			{ text: '「文脈外」', font: "'Noto Serif JP', serif" },
			{ text: '"HORS CONTEXTE"', font: "var(--font-mono)" },
			{ text: '"FUORI CONTESTO"', font: "var(--font-mono)" },
			{ text: '"UR SITT SAMMANHANG"', font: "var(--font-mono)" },
			{ text: '«خارج السياق»', font: "'Noto Kufi Arabic', sans-serif" },
		];
		const pick = variants[Math.floor(Math.random() * variants.length)];
		const el = document.querySelector<HTMLElement>('.site-title');
		if (el) {
			el.textContent = pick.text;
			el.style.fontFamily = pick.font;
		}
	}
	randomizeTitle();
	document.addEventListener('astro:after-swap', randomizeTitle);
</script>

<style>
	header {
		box-shadow: var(--fg) 0 -2px 0 0 inset;
		padding: 0 var(--grid-padding);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 3rem;
	}
	.site-title {
		font-weight: 400;
		text-decoration: none;
		color: var(--fg);
		text-transform: uppercase;
	}
	.site-title:hover {
		text-decoration: none;
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.5ch;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.5ch;
	}
	.sep {
		color: var(--border);
		user-select: none;
	}
	.action-btn {
		display: flex;
		align-items: center;
		gap: 0;
		background: none;
		border: none;
		color: var(--fg);
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 1rem;
		line-height: 1;
		padding: 0;
	}
	.hotkey {
		padding: 4px 6px;
		background: var(--action-hotkey-bg);
	}
	.label {
		padding: 4px 8px;
		background: var(--action-content-bg);
		text-transform: uppercase;
	}
	.action-btn:hover .label {
		background: var(--accent);
		color: var(--bg);
	}
	@media (max-width: 520px) {
		nav {
			flex-wrap: wrap;
			height: auto;
			padding: 0.6rem 0;
			gap: 0.4rem;
		}
		.site-title {
			width: 100%;
		}
		.hotkey {
			display: none;
		}
	}
</style>
