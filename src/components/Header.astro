---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="site-title">{SITE_TITLE}</a>
		<div class="nav-links">
			<HeaderLink href="/">Index</HeaderLink>
			<span class="sep">/</span>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<span class="sep">/</span>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<!-- Fixed action bar (SRCL-style) -->
<div class="action-bar" id="action-bar">
	<button class="action-btn" id="theme-toggle" tabindex="0" role="button">
		<span class="hotkey">&#x2303;+T</span>
		<span class="label" id="theme-label">Light</span>
	</button>
</div>

<script>
	function initTheme() {
		const toggle = document.getElementById('theme-toggle');
		const label = document.getElementById('theme-label');
		const root = document.documentElement;

		const saved = localStorage.getItem('theme');
		if (saved === 'light') {
			root.classList.add('theme-light');
			if (label) label.textContent = 'Dark';
		}

		toggle?.addEventListener('click', () => {
			root.classList.toggle('theme-light');
			const isLight = root.classList.contains('theme-light');
			localStorage.setItem('theme', isLight ? 'light' : 'dark');
			if (label) label.textContent = isLight ? 'Dark' : 'Light';
		});
	}
	initTheme();
	document.addEventListener('astro:after-swap', initTheme);
</script>

<style>
	header {
		border-bottom: 1px solid var(--border);
		padding: 0 var(--grid-padding);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 3rem;
	}
	.site-title {
		font-weight: 500;
		text-decoration: none;
		color: var(--fg);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: 0.85rem;
	}
	.site-title:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.85rem;
	}
	.sep {
		color: var(--fg-dim);
		user-select: none;
	}

	/* SRCL-style fixed action bar */
	.action-bar {
		position: fixed;
		bottom: 24px;
		left: var(--grid-padding);
		z-index: 100;
		display: flex;
		gap: 2px;
	}
	.action-btn {
		display: flex;
		align-items: center;
		gap: 0;
		background: var(--border);
		border: none;
		color: var(--fg);
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1;
		padding: 0;
		transition: background 0.15s;
	}
	.action-btn:hover {
		background: var(--fg-dim);
	}
	.action-btn:hover .label {
		background: var(--accent);
		color: var(--bg);
	}
	.hotkey {
		padding: 6px 8px;
		opacity: 0.6;
	}
	.label {
		padding: 6px 10px;
		background: var(--fg-dim);
		color: var(--fg);
		transition: background 0.15s, color 0.15s;
		text-transform: uppercase;
		font-weight: 500;
		letter-spacing: 0.03em;
	}
	@media (max-width: 768px) {
		.action-bar {
			bottom: 16px;
			left: var(--grid-padding);
		}
		.hotkey {
			display: none;
		}
	}
</style>
