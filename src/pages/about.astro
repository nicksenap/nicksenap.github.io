---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description="About me" />
	</head>
	<body>
		<Header />
		<main>
			<div class="section-header">ABOUT</div>
			<div class="prose">
				<p>
					Hello. I'm a software engineer interested in building
					things for the web. This blog is where I write about
					technology, programming, and ideas.
				</p>
				<p>
					Feel free to reach out via email or find me on GitHub.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.section-header {
		font-size: 0.75rem;
		color: var(--fg-muted);
		letter-spacing: 0.08em;
		margin-bottom: 0.75rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--border);
	}
	.prose {
		max-width: 55ch;
	}
</style>
