---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description="About me" />
	</head>
	<body>
		<Header />
		<main>
			<div class="section-label">ABOUT</div>
			<div class="prose">
				<p>
					Hello. I'm a software engineer interested in building
					things for the web. This blog is where I write about
					technology, programming, and ideas.
				</p>
				<p>
					Feel free to reach out via email or find me on GitHub.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.section-label {
		margin-bottom: 0.75rem;
		padding-bottom: 0.5rem;
		box-shadow: var(--border) 0 -1px 0 0 inset;
	}
</style>
