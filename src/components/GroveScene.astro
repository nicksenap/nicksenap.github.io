---
/**
 * The grove: three repos as wire trunks on one ground, animated through the gw workflow.
 * create → status → sync → delete, on a loop. Drag to rotate; click a phase to jump to it.
 */
const PHASES = [
	{ id: 'create', cmd: 'gw create -b feat/login -r web,api,worker' },
	{ id: 'status', cmd: 'gw status feat-login' },
	{ id: 'sync', cmd: 'gw sync feat-login' },
	{ id: 'delete', cmd: 'gw delete feat-login' },
];
---

<figure class="grove" data-grove>
	<canvas class="grove-canvas" width="640" height="500"></canvas>
	<div class="grove-labels"></div>
	<figcaption>
		<p class="grove-cmd" aria-live="polite"><span class="ps">$</span> <span class="typed"></span><span class="caret"></span></p>
		<pre class="grove-out" aria-live="polite"></pre>
		<div class="grove-phases" role="group" aria-label="workflow phase">
			{PHASES.map((p) => (
				<button type="button" class="phase" data-phase={p.id} aria-pressed="false">{p.id}</button>
			))}
		</div>
		<span class="grove-hint">drag to rotate</span>
	</figcaption>
</figure>

<script>
	import Zdog from 'zdog';

	const TAU = Zdog.TAU;
	const PHASES = [
		{ id: 'create', cmd: 'gw create -b feat/login -r web,api,worker', dur: 4.6, out: ['web      feat/login   from origin/main', 'api      feat/login   from origin/main', 'worker   feat/login   from origin/stage'] },
		{ id: 'status', cmd: 'gw status feat-login', dur: 3.4, out: ['web      feat/login   M src/auth.ts', 'api      feat/login   clean', 'worker   feat/login   M jobs/session.go'] },
		{ id: 'sync', cmd: 'gw sync feat-login', dur: 3.6, out: ['web      rebased onto origin/main', 'api      rebased onto origin/main', 'worker   rebased onto origin/stage'] },
		{ id: 'delete', cmd: 'gw delete feat-login', dur: 3.6, out: ['web      worktree removed, branch deleted', 'api      worktree removed, branch deleted', 'worker   worktree removed, branch deleted'] },
		{ id: 'rest', cmd: '', dur: 1.6, out: [] },
	];
	const TOTAL = PHASES.reduce((s, p) => s + p.dur, 0);
	const REPOS = [
		{ name: 'web', x: -100, changed: true },
		{ name: 'api', x: 0, changed: false },
		{ name: 'worker', x: 100, changed: true },
	];
	const H = 130; // trunk height
	const HB = 72; // branch height
	const LB = 58; // branch length (toward the viewer)

	type Colors = { fg: string; dim: string; accent: string };
	const clamp = (v: number) => Math.min(1, Math.max(0, v));
	const ease = (v: number) => v * v * (3 - 2 * v);
	const seg = (t: number, a: number, b: number) => ease(clamp((t - a) / (b - a)));
	function rgba(hex: string, a: number) {
		const h = hex.replace('#', '');
		const n = parseInt(h.length === 3 ? h.split('').map((c) => c + c).join('') : h, 16);
		return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a.toFixed(3)})`;
	}

	function init(root: HTMLElement) {
		const canvas = root.querySelector('canvas') as HTMLCanvasElement;
		const labelsEl = root.querySelector('.grove-labels') as HTMLElement;
		const typedEl = root.querySelector('.typed') as HTMLElement;
		const outEl = root.querySelector('.grove-out') as HTMLElement;
		const cmdEl = root.querySelector('.grove-cmd') as HTMLElement;
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('.phase')];
		const readColors = (): Colors => {
			const css = getComputedStyle(document.documentElement);
			return {
				fg: css.getPropertyValue('--fg').trim() || '#ffffff',
				dim: css.getPropertyValue('--border').trim() || '#3d3d3d',
				accent: css.getPropertyValue('--accent').trim() || '#ef6300',
			};
		};
		let c = readColors();
		new MutationObserver(() => (c = readColors())).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

		const touch = matchMedia('(pointer: coarse)').matches;
		const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
		root.classList.toggle('grove-touch', touch);
		const illo = new Zdog.Illustration({
			element: canvas,
			dragRotate: !touch,
			rotate: { x: -TAU / 16, y: TAU / 14 },
			resize: true,
		});
		const wire = (stroke = 1.5) => ({ stroke, color: '#000', fill: false });

		// ---- ground ----
		const ground = new Zdog.Ellipse({ addTo: illo, diameter: 300, rotate: { x: TAU / 4 }, ...wire(1) });
		const groundInner = new Zdog.Ellipse({ addTo: illo, diameter: 300, rotate: { x: TAU / 4 }, translate: { y: 3 }, ...wire(1) });

		// ---- trees ----
		type Tree = {
			trunk: Zdog.Shape;
			twigs: Zdog.Shape[];
			newTwig: Zdog.Shape;
			branch: Zdog.Anchor;
			branchLine: Zdog.Shape;
			tip: Zdog.Shape;
			mark: Zdog.Shape;
			base: HTMLElement;
		};
		const trees: Tree[] = REPOS.map((r, i) => {
			const trunk = new Zdog.Shape({ addTo: illo, path: [{ x: r.x, y: 0 }, { x: r.x, y: -H }], ...wire(2) });
			// a few old commits: short twigs on main, different per repo
			const twigs = [
				[-38, -1, 16],
				[-62, 1, 14],
				[-98, -1, 12],
			]
				.slice(0, 2 + (i % 2))
				.map(([y, side, len]) => new Zdog.Shape({ addTo: illo, path: [{ x: r.x, y }, { x: r.x + side * len, y: y - len * 0.6 }], ...wire(1) }));
			const newTwig = new Zdog.Shape({ addTo: illo, path: [{ x: r.x, y: -H + 14 }, { x: r.x + (i % 2 ? -1 : 1) * 14, y: -H + 4 }], ...wire(1) });
			const branch = new Zdog.Anchor({ addTo: illo, translate: { x: r.x, y: -HB }, scale: { z: 0.001 } });
			const branchLine = new Zdog.Shape({ addTo: branch, path: [{ z: 0 }, { z: LB }], ...wire(1.5) });
			const tip = new Zdog.Shape({ addTo: branch, translate: { z: LB }, stroke: 4, color: '#000' });
			const mark = new Zdog.Shape({ addTo: branch, path: [{ x: -4, y: -5, z: LB }, { x: 4, y: -5, z: LB }, { x: 0, y: -12, z: LB }], closed: true, ...wire(1) });
			const base = document.createElement('div');
			base.className = 'grove-label base';
			base.innerHTML = `<b>${r.name}</b><span>main</span>`;
			labelsEl.append(base);
			return { trunk, twigs, newTwig, branch, branchLine, tip, mark, base };
		});

		// ---- workspace plane: joins the three branch tips ----
		const plane = new Zdog.Anchor({ addTo: illo, translate: { y: -HB, z: LB } });
		const planeRect = new Zdog.Rect({ addTo: plane, width: 250, height: 30, rotate: { x: TAU / 4 }, ...wire(1) });
		const planeRail = new Zdog.Shape({ addTo: plane, path: [{ x: -125 }, { x: 125 }], ...wire(1) });
		const wsLabel = document.createElement('div');
		wsLabel.className = 'grove-label ws';
		wsLabel.innerHTML = `<b>feat-login/</b><span>web · api · worker</span>`;
		labelsEl.append(wsLabel);

		// ---- timeline ----
		let t = still ? PHASES[0].dur + PHASES[1].dur - 0.1 : 0;
		let last = performance.now();
		let playing = !still;
		let visible = true;
		new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.05 }).observe(root);
		const phaseStart = (i: number) => PHASES.slice(0, i).reduce((s, p) => s + p.dur, 0);
		buttons.forEach((b, i) => {
			b.addEventListener('click', () => {
				t = still ? phaseStart(i) + PHASES[i].dur - 0.1 : phaseStart(i);
			});
		});

		const baseY = illo.rotate.y;
		let sway = 0;
		let lastCmd = '';
		let lastOut = '';

		function frame(now: number) {
			const dt = Math.min(0.05, (now - last) / 1000);
			last = now;
			if (playing && visible && !document.hidden) t = (t + dt) % TOTAL;

			// phase-local time
			let pi = 0;
			let pt = t;
			while (pt >= PHASES[pi].dur) {
				pt -= PHASES[pi].dur;
				pi++;
			}
			const phase = PHASES[pi];

			let len = 0, planeA = 0, marks = 0, lift = 0, twig = 0;
			switch (phase.id) {
				case 'create':
					len = seg(pt, 1.1, 2.6);
					planeA = seg(pt, 2.4, 3.6);
					break;
				case 'status':
					len = 1; planeA = 1;
					marks = seg(pt, 0.9, 1.7);
					break;
				case 'sync':
					len = 1; planeA = 1; marks = 1;
					twig = seg(pt, 0.9, 1.6);
					lift = seg(pt, 1.4, 2.6) * 30;
					break;
				case 'delete':
					len = 1 - seg(pt, 1.4, 2.8);
					planeA = 1 - seg(pt, 0.9, 1.9);
					marks = 1 - seg(pt, 0.6, 1.3);
					lift = 30; twig = 1;
					break;
				case 'rest':
					twig = 1 - seg(pt, 0.2, 1.2);
					break;
			}

			// colours (theme may have changed)
			ground.color = c.dim;
			groundInner.color = rgba(c.dim, 0.5);
			planeRect.color = rgba(c.fg, planeA * 0.9);
			planeRail.color = rgba(c.accent, planeA);
			plane.translate.y = -HB - lift;
			trees.forEach((tr, i) => {
				tr.trunk.color = c.fg;
				tr.twigs.forEach((tw) => (tw.color = c.dim));
				tr.newTwig.color = rgba(c.fg, twig);
				tr.branch.scale.z = Math.max(0.001, len);
				tr.branch.translate.y = -HB - lift;
				tr.branchLine.color = rgba(c.accent, len > 0 ? 1 : 0);
				tr.tip.color = rgba(c.accent, seg(len, 0.85, 1));
				tr.mark.color = rgba(c.accent, marks * (REPOS[i].changed ? 1 : 0));
			});

			sway += dt * 0.35;
			if (!(illo as any).isDragging) illo.rotate.y = baseY + Math.sin(sway) * 0.22;
			const rect = canvas.getBoundingClientRect();
			const compact = rect.width < 520;
			illo.zoom = rect.width / (compact ? 360 : 380);
			illo.translate.y = 40;
			illo.updateRenderGraph();

			// ---- labels ----
			labelsEl.classList.toggle('compact', compact);
			trees.forEach((tr) => {
				// base label: under the trunk foot
				const foot = tr.trunk.pathCommands[0].renderPoints[0];
				tr.base.style.transform = `translate(${rect.width / 2 + foot.x * illo.zoom}px, ${rect.height / 2 + foot.y * illo.zoom + 10}px) translateX(-50%)`;
				tr.base.style.opacity = '1';
			});
			const railEnd = planeRail.pathCommands[1].renderPoints[0];
			wsLabel.style.transform = `translate(${rect.width / 2 + railEnd.x * illo.zoom + 22}px, ${rect.height / 2 + railEnd.y * illo.zoom - 8}px)`;
			wsLabel.style.opacity = String(planeA);

			// ---- caption: type the command, then print output a line at a time ----
			const typing = 0.9;
			const shown = phase.id === 'rest' ? '' : phase.cmd.slice(0, Math.floor(clamp(pt / typing) * phase.cmd.length));
			if (shown !== lastCmd) {
				lastCmd = shown;
				typedEl.textContent = shown;
			}
			const nOut = phase.id === 'rest' ? 0 : Math.min(phase.out.length, Math.max(0, Math.floor((pt - typing - 0.15) / 0.22)));
			const outHtml = phase.out
				.slice(0, nOut)
				.map((l) => l.replace(/(M \S+)/, '<i>$1</i>'))
				.join('\n');
			if (outHtml !== lastOut) {
				lastOut = outHtml;
				outEl.innerHTML = outHtml;
			}
			cmdEl.classList.toggle('idle', phase.id === 'rest');
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.phase === phase.id)));

			requestAnimationFrame(frame);
		}
		requestAnimationFrame(frame);
	}

	document.querySelectorAll<HTMLElement>('[data-grove]').forEach(init);
</script>

<style is:global>
	.grove {
		position: relative;
		margin: 2rem auto 2.5rem;
		width: min(100%, 60vh);
		user-select: none;
	}
	.grove-canvas {
		display: block;
		width: 100%;
		aspect-ratio: 640 / 500;
		height: auto;
		cursor: grab;
	}
	.grove-canvas:active {
		cursor: grabbing;
	}
	.grove-touch .grove-canvas {
		cursor: default;
	}
	.grove-touch .grove-hint {
		visibility: hidden;
	}
	.grove-labels {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.grove-label {
		position: absolute;
		top: 0;
		left: 0;
		transform: translate(-1000px, -1000px);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		line-height: 1.2;
		color: var(--fg);
		white-space: nowrap;
		opacity: 0;
	}
	.grove-label b {
		display: block;
		font-weight: 600;
	}
	.grove-label span {
		display: block;
		color: var(--dim);
	}
	.grove-label.base {
		text-align: center;
	}
	.grove-labels.compact .grove-label.ws span {
		display: none;
	}
	.grove figcaption {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.4rem 2ch;
		align-items: center;
		margin-top: 0.25rem;
		font-size: 0.75rem;
		color: var(--dim);
	}
	.grove-cmd {
		grid-column: 1 / -1;
		margin: 0;
		color: var(--fg);
		min-height: 1.25em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.grove-cmd .ps {
		color: var(--accent);
	}
	.grove-out {
		grid-column: 1 / -1;
		margin: 0;
		padding: 0;
		background: none !important;
		box-shadow: none;
		font-size: 0.75rem;
		line-height: 1.25;
		min-height: calc(3 * 1.25em);
		color: var(--dim);
		white-space: pre;
		overflow: hidden;
	}
	.grove-out i {
		font-style: normal;
		color: var(--accent);
	}
	.grove-cmd .caret {
		display: inline-block;
		width: 0.6ch;
		height: 1em;
		vertical-align: -0.15em;
		background: var(--fg);
		animation: grove-blink 1s steps(2) infinite;
	}
	.grove-cmd.idle .caret {
		animation-duration: 1.4s;
	}
	.grove-phases {
		display: flex;
		gap: 1.5ch;
	}
	.phase {
		all: unset;
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--dim);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 3px;
	}
	.phase:hover {
		color: var(--fg);
	}
	.phase:focus-visible {
		outline: 1px solid var(--fg);
		outline-offset: 2px;
	}
	.phase[aria-pressed='true'] {
		color: var(--fg);
		text-decoration-color: var(--accent);
	}
	.grove-hint {
		text-align: right;
	}
	@keyframes grove-blink {
		to { visibility: hidden; }
	}
	@media (prefers-reduced-motion: reduce) {
		.grove-cmd .caret {
			animation: none;
		}
	}
	@media (max-width: 519px) {
		.grove figcaption {
			grid-template-columns: 1fr;
		}
		.grove-hint {
			display: none;
		}
	}
</style>
