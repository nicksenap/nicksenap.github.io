---
/**
 * Backdrop scene: a WebGL fragment shader (sea, sky, fog, grain; stars at night), rendered behind
 * the page and veiled under the text column, like earendil.com. Greyscale only. Day/night follows the
 * theme. Off under html.no-fx; a single still frame under prefers-reduced-motion.
 */
---

<canvas class="backdrop-night" aria-hidden="true"></canvas>

<script>
	const FRAG = `
precision highp float;
uniform vec2 u_res;
uniform float u_time;
uniform float u_day; // 0 = night, 1 = day

// Ocean: afl_ext 2017-2024, MIT License (shadertoy "Very realistic ocean", MdXyzX), trimmed and
// re-tuned. Sky, stars, greyscale grading and grain are ours.
#define DRAG_MULT 0.38
#define WATER_DEPTH 1.0
#define CAMERA_HEIGHT 1.5
#define CAMERA_TILT 0.14
#define PROJ_DEPTH 1.5
#define ITER_RAYMARCH 6
#define ITER_NORMAL 20
#define RAYMARCH_STEPS 24

float hash21(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

vec2 wavedx(vec2 position, vec2 direction, float frequency, float timeshift) {
	float x = dot(direction, position) * frequency + timeshift;
	float wave = exp(sin(x) - 1.0);
	float dx = wave * cos(x);
	return vec2(wave, -dx);
}

// Sum of many small waves, each one dragging the sample position along its own direction.
float getwaves(vec2 position, int iterations) {
	float wavePhaseShift = length(position) * 0.1;
	vec2 swellDir = normalize(vec2(-0.25, 1.0));
	float iter = 0.0;
	float frequency = 1.0;
	float timeMultiplier = 2.0;
	float weight = 1.0;
	float sumOfValues = 0.0;
	float sumOfWeights = 0.0;
	for (int i = 0; i < 24; i++) {
		if (i >= iterations) break;
		vec2 p = normalize(mix(vec2(sin(iter), cos(iter)), swellDir, 0.35));
		vec2 res = wavedx(position, p, frequency, u_time * timeMultiplier + wavePhaseShift);
		position += p * res.y * weight * DRAG_MULT;
		sumOfValues += res.x * weight;
		sumOfWeights += weight;
		weight = mix(weight, 0.0, 0.2);
		frequency *= 1.18;
		timeMultiplier *= 1.07;
		iter += 1232.399963;
	}
	float base = sumOfValues / sumOfWeights;
	// long swell that rolls through the whole surface
	float swell = sin(dot(position, swellDir) * 0.18 - u_time * 0.08);
	return base + swell * 0.35;
}

float raymarchwater(vec3 camera, vec3 start, vec3 end, float depth) {
	vec3 pos = start;
	vec3 dir = normalize(end - start);
	for (int i = 0; i < RAYMARCH_STEPS; i++) {
		float height = getwaves(pos.xz, ITER_RAYMARCH) * depth - depth;
		if (height + 0.01 > pos.y) return distance(pos, camera);
		pos += dir * (pos.y - height);
	}
	return distance(start, camera);
}

vec3 normal(vec2 pos, float e, float depth) {
	vec2 ex = vec2(e, 0);
	float H = getwaves(pos.xy, ITER_NORMAL) * depth;
	vec3 a = vec3(pos.x, H, pos.y);
	return normalize(cross(
		a - vec3(pos.x - e, getwaves(pos.xy - ex.xy, ITER_NORMAL) * depth, pos.y),
		a - vec3(pos.x, getwaves(pos.xy + ex.yx, ITER_NORMAL) * depth, pos.y + e)));
}

mat3 rotX(float angle) {
	float s = sin(angle), c = cos(angle);
	return mat3(1.0, 0.0, 0.0, 0.0, c, -s, 0.0, s, c);
}

vec3 getRay(vec2 fragCoord) {
	vec2 uv = ((fragCoord.xy / u_res.xy) * 2.0 - 1.0) * vec2(u_res.x / u_res.y, 1.0);
	vec3 proj = normalize(vec3(uv.x, uv.y, PROJ_DEPTH));
	return rotX(CAMERA_TILT) * proj;
}

float intersectPlane(vec3 origin, vec3 direction, vec3 point, vec3 normal) {
	return clamp(dot(point - origin, normal) / dot(direction, normal), -1.0, 9991999.0);
}

vec3 extra_cheap_atmosphere(vec3 raydir, vec3 sundir) {
	float special_trick = 1.0 / (raydir.y * 1.0 + 0.1);
	float special_trick2 = 1.0 / (sundir.y * 11.0 + 1.0);
	float raysundt = pow(abs(dot(sundir, raydir)), 2.0);
	float sundt = pow(max(0.0, dot(sundir, raydir)), 8.0);
	float mymie = sundt * special_trick * 0.2;
	vec3 suncolor = mix(vec3(1.0), max(vec3(0.0), vec3(1.0) - vec3(5.5, 13.0, 22.4) / 22.4), special_trick2);
	vec3 bluesky = vec3(5.5, 13.0, 22.4) / 22.4 * suncolor;
	vec3 bluesky2 = max(vec3(0.0), bluesky - vec3(5.5, 13.0, 22.4) * 0.002 * (special_trick + -6.0 * sundir.y * sundir.y));
	bluesky2 *= special_trick * (0.24 + raysundt * 0.24);
	return bluesky2 * (1.0 + 1.0 * pow(1.0 - raydir.y, 3.0)) + mymie * suncolor;
}

vec3 aces_tonemap(vec3 color) {
	mat3 m1 = mat3(0.59719, 0.07600, 0.02840, 0.35458, 0.90834, 0.13383, 0.04823, 0.01566, 0.83777);
	mat3 m2 = mat3(1.60475, -0.10208, -0.00327, -0.53108, 1.10813, -0.07276, -0.07367, -0.00605, 1.07602);
	vec3 v = m1 * color;
	vec3 a = v * (v + 0.0245786) - 0.000090537;
	vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
	return pow(clamp(m2 * (a / b), 0.0, 1.0), vec3(1.0 / 2.2));
}

// ---- ours: sky ----
vec3 sunDir() { return normalize(vec3(-0.08, 0.6, 0.58)); }

float star(vec2 uv, vec2 grid) {
	vec2 cell = floor(uv * grid);
	if (hash21(cell) > 0.16) return 0.0;
	vec2 pos = (cell + vec2(hash21(cell + 0.1), hash21(cell + 0.2))) / grid;
	float dpx = length((uv - pos) * u_res);
	float size = 0.25 + hash21(cell + 0.3) * 0.3;
	float core = smoothstep(size, size * 0.2, dpx);
	float flick = 0.75 + 0.25 * sin(u_time * (0.3 + hash21(cell + 0.5) * 0.5) + hash21(cell + 0.4) * 6.2832);
	return core * flick * mix(0.5, 1.0, hash21(cell + 0.6));
}

vec3 daySky(vec3 dir) { return extra_cheap_atmosphere(dir, sunDir()) * 0.5; }
vec3 nightSky(vec3 dir, vec2 uv, bool withStars) {
	float h = clamp(dir.y, 0.0, 1.0);
	vec3 c = mix(vec3(0.035), vec3(0.012), pow(h, 0.7));
	if (withStars) c += star(uv, vec2(70.0 * u_res.x / u_res.y, 70.0)) * 0.8 * smoothstep(0.0, 0.12, dir.y);
	return c;
}
vec3 sky(vec3 dir, vec2 uv, bool withStars) {
	return mix(nightSky(dir, uv, withStars), daySky(dir), u_day);
}

void main() {
	vec2 uv = gl_FragCoord.xy / u_res;
	vec3 ray = getRay(gl_FragCoord.xy);
	vec3 C;
	float dist = 0.0;

	if (ray.y >= 0.0) {
		C = sky(ray, uv, true) * 2.0;
	} else {
		vec3 origin = vec3(u_time * 0.2, CAMERA_HEIGHT, 1.0);
		float hiHit = intersectPlane(origin, ray, vec3(0.0), vec3(0.0, 1.0, 0.0));
		float loHit = intersectPlane(origin, ray, vec3(0.0, -WATER_DEPTH, 0.0), vec3(0.0, 1.0, 0.0));
		dist = raymarchwater(origin, origin + ray * hiHit, origin + ray * loHit, WATER_DEPTH);
		vec3 hit = origin + ray * dist;

		float eps = max(0.01, dist * 0.004);
		vec3 N = normal(hit.xz, eps, WATER_DEPTH);
		// flatten far normals so the horizon doesn't sparkle
		N = mix(N, vec3(0.0, 1.0, 0.0), 0.8 * min(1.0, sqrt(dist * 0.01) * 1.1));

		float fresnel = 0.04 + 0.96 * pow(1.0 - max(0.0, dot(-N, ray)), 5.0);
		vec3 R = normalize(reflect(ray, N));
		R.y = abs(R.y);
		vec3 reflection = sky(R, uv, false);
		vec3 scatterBase = mix(vec3(0.02), vec3(0.08), u_day);
		vec3 scattering = scatterBase * (0.2 + (hit.y + WATER_DEPTH) / WATER_DEPTH);
		C = fresnel * reflection + scattering;

		vec3 fogColor = mix(vec3(0.035), vec3(0.7), u_day);
		C = mix(C, fogColor, 1.0 - exp(-dist * mix(0.02, 0.03, u_day)));
		C *= mix(1.9, 1.4, u_day);
	}

	vec3 col = aces_tonemap(C);
	// greyscale: keep the shading, drop the hue
	col = vec3(dot(col, vec3(0.299, 0.587, 0.114)));
	// day: lift toward the paper so it sits with the warm page
	col = mix(col, mix(col, vec3(0.9), 0.4), u_day);
	// grain
	float g = hash21(gl_FragCoord.xy + fract(u_time * 7.0) * 100.0) - 0.5;
	col += g * mix(0.05, 0.03, u_day);
	gl_FragColor = vec4(col, 1.0);
}
`;

	const VERT = `attribute vec2 a; void main(){ gl_Position = vec4(a, 0.0, 1.0); }`;

	function init() {
		const canvas = document.querySelector<HTMLCanvasElement>('.backdrop-night');
		if (!canvas) return;
		const gl = canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });
		if (!gl) return;
		const root = document.documentElement;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)');

		const sh = (type: number, src: string) => {
			const s = gl.createShader(type)!;
			gl.shaderSource(s, src);
			gl.compileShader(s);
			if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) || 'shader');
			return s;
		};
		let prog: WebGLProgram;
		try {
			prog = gl.createProgram()!;
			gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
			gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
			gl.linkProgram(prog);
			if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error('link');
		} catch (e) {
			console.warn('[backdrop-night]', e);
			return;
		}
		gl.useProgram(prog);
		const buf = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buf);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
		const a = gl.getAttribLocation(prog, 'a');
		gl.enableVertexAttribArray(a);
		gl.vertexAttribPointer(a, 2, gl.FLOAT, false, 0, 0);
		const uRes = gl.getUniformLocation(prog, 'u_res');
		const uTime = gl.getUniformLocation(prog, 'u_time');
		const uDay = gl.getUniformLocation(prog, 'u_day');
		const isLight = () => root.classList.contains('theme-light');
		let day = isLight() ? 1 : 0;
		let first = true; // snap on the first frame, ease afterwards

		// Raymarching is per-pixel work: render small and let the browser upscale.
		const SCALE = 0.4;
		let ready = false;
		function resize() {
			const dpr = Math.min(devicePixelRatio || 1, 2) * SCALE;
			const w = Math.round(innerWidth * dpr);
			const h = Math.round(innerHeight * dpr);
			if (w === canvas.width && h === canvas.height) return;
			// Setting the size clears the buffer to black; redraw in the same task so that frame is
			// never painted (otherwise the page flashes until the next 30 fps tick).
			canvas.width = w;
			canvas.height = h;
			gl.viewport(0, 0, w, h);
			if (ready && active()) draw();
		}
		resize();
		addEventListener('resize', resize);

		const t0 = performance.now();
		function draw() {
			gl.uniform2f(uRes, canvas.width, canvas.height);
			day = first ? (isLight() ? 1 : 0) : day + ((isLight() ? 1 : 0) - day) * 0.08;
			first = false;
			gl.uniform1f(uDay, Math.abs(day - Math.round(day)) < 0.002 ? Math.round(day) : day);
			gl.uniform1f(uTime, (performance.now() - t0) / 1000);
			gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
			root.classList.add('backdrop-night-ready');
		}

		let raf = 0;
		let last = 0;
		function frame(t: number) {
			raf = requestAnimationFrame(frame);
			if (t - last < 33) return; // 30 fps
			last = t;
			draw();
		}
		const active = () => !root.classList.contains('no-fx') && !document.hidden;
		ready = true;
		function sync() {
			cancelAnimationFrame(raf);
			if (!active()) return;
			if (reduced.matches) {
				draw();
				return;
			}
			raf = requestAnimationFrame(frame);
		}
		sync();
		reduced.addEventListener('change', sync);
		document.addEventListener('visibilitychange', sync);
		new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['class'] });
	}

	init();
</script>

<style is:global>
	.backdrop-night {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -2;
		pointer-events: none;
		opacity: 0;
		transition: opacity 1s;
	}
	html:not(.no-fx).backdrop-night-ready .backdrop-night {
		opacity: 1;
	}
	/* Once the first frame exists, the body goes transparent and the scene shows through... */
	html:not(.no-fx).backdrop-night-ready body {
		background: transparent;
	}
	/* ...behind a veil in the page colour: near-opaque over the text column, clear at the edges.
	   Same idea as earendil.com's content pages, centred on our left-aligned column. */
	html:not(.no-fx).backdrop-night-ready body::before {
		content: '';
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(
			ellipse min(78vw, 720px) 118% at min(50vw, calc(var(--content-width) / 2)) 48%,
			rgb(from var(--bg) r g b / 0.985) 0%,
			rgb(from var(--bg) r g b / 0.985) 42%,
			rgb(from var(--bg) r g b / 0.95) 54%,
			rgb(from var(--bg) r g b / 0.7) 68%,
			rgb(from var(--bg) r g b / 0.3) 82%,
			rgb(from var(--bg) r g b / 0) 100%
		);
	}
	/* the home page exposes the scene: only a light veil under the intro text */
	html:not(.no-fx).backdrop-night-ready body.home::before {
		background: radial-gradient(
			ellipse min(70vw, 640px) 60% at min(50vw, calc(var(--content-width) / 2)) 22%,
			rgb(from var(--bg) r g b / 0.7) 0%,
			rgb(from var(--bg) r g b / 0.55) 45%,
			rgb(from var(--bg) r g b / 0.2) 75%,
			rgb(from var(--bg) r g b / 0) 100%
		);
	}
	/* the harness page asks for a quieter backdrop while its model is apart */
	html.backdrop-quiet .backdrop-night {
		opacity: 0.4;
	}
</style>
